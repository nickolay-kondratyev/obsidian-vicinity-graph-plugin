{
	"name": "vicinity-graph",
	"version": "0.1.11",
	"private": true,
	"description": "A richer local graph of the notes near your active note — a folder-grouped alternative to the built-in local graph.",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"setup:dev-vault": "bash scripts/setup-dev-vault.sh",
		"setup:obsidian": "bash scripts/setup-obsidian-bin.sh",
		"build": "npm run check && node esbuild.config.mjs production",
		"check": "tsc -noEmit && npm run check:e2e",
		"check:e2e": "bash scripts/check-e2e.sh",
		"lint": "eslint src e2e",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:all": "bash scripts/run-all-tests.sh",
		"test:e2e": "bash scripts/run-e2e.sh",
		"test:e2e:floor": "bash scripts/run-e2e-floor.sh",
		"test:watch": "vitest"
	},
	"license": "SEE LICENSE IN LICENSE.md",
	"dependencies": {
		"@xyflow/react": "^12.11.2",
		"d3-force": "^3.0.0",
		"elkjs": "^0.12.0",
		"libavoid-js": "0.4.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"stable-ids-for-obsidian": "^0.1.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^26.1.1",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jsdom": "^30.0.1",
		"obsidian": "1.12.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.10"
	}
}
