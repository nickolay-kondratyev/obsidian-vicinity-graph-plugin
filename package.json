{
	"name": "vicinity-graph",
	"version": "0.1.1",
	"private": true,
	"description": "A richer local graph that shows the nearby notes around your active note (an improved alternative to Obsidian's built-in local graph).",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"setup:dev-vault": "bash scripts/setup-dev-vault.sh",
		"setup:obsidian": "bash scripts/setup-obsidian-bin.sh",
		"build": "npm run check && node esbuild.config.mjs production",
		"check": "tsc -noEmit && npm run check:e2e",
		"check:e2e": "tsc -noEmit -p e2e/tsconfig.json",
		"test": "vitest run",
		"test:e2e": "bash scripts/run-e2e.sh",
		"test:watch": "vitest"
	},
	"license": "SEE LICENSE IN LICENSE.md",
	"dependencies": {
		"@xyflow/react": "^12.11.2",
		"d3-force": "^3.0.0",
		"elkjs": "^0.12.0",
		"libavoid-js": "0.4.5",
		"obsidian-id-lib": "^0.1.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^26.1.1",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"esbuild": "^0.25.5",
		"obsidian": "1.12.3",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10"
	}
}
