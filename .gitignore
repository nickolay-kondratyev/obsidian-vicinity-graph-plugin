# Dependencies
node_modules/

# Build output (bundled by esbuild from src/)
main.js
*.map
# Generated at build time = @xyflow/react base CSS + the src/view/*.css sources
# listed in esbuild.config.mjs's AUTHORED_CSS_FILES.
styles.css

# Local Obsidian dev vault (created by the build's copy step)
.dev-vault/

# Temp / scratch
.tmp/
.out/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Obsidian plugin runtime settings. `doc-data/` too: when the repo is symlinked
# into a vault as the plugin dir, the vault's per-doc state lands in the checkout.
data.json
doc-data/
